#!/system/bin/sh

MODDIR=/data/adb/modules/playintegrityfix

if [ ! -f "$MODDIR/attestation.dex" ]; then
    echo "Error: attestation.dex not found in $MODDIR"
    exit 1
fi

CLASSPATH="$MODDIR/attestation.dex"

exec /system/bin/app_process -Djava.class.path="$CLASSPATH" "$MODDIR" --nice-name=TrickyStoreOSS io.github.beakthoven.TrickyStoreOSS.MainKt
